---
import '../styles/layout.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Open Rosary',
	description = 'Pray the Rosary. Fast, free, and mobile-friendly.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<slot />
	</body>
</html>
